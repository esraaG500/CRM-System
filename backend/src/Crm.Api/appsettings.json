{
  "ConnectionStrings": {
    "Crm": ""
  },
  "Jwt": {
    "Issuer": "crm-api",
    "Audience": "crm-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Seed": {
    "AdminEmail": "admin@crm.local",
    "AdminPassword": "",
    "SampleData": false
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Cors": {
    "Origins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*"
}
